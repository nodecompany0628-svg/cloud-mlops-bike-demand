{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LambdaLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:*:*:log-group:/aws/lambda/bike-demand-predict:*"
    },
    {
      "Sid": "ReadModels",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": "arn:aws:s3:::bike-demand-mlops-*/models/*"
    }
  ]
}
