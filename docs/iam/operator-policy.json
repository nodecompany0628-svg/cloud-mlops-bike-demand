{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "FindProjectBucket",
      "Effect": "Allow",
      "Action": "s3:ListAllMyBuckets",
      "Resource": "*"
    },
    {
      "Sid": "ProjectBucket",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:DeleteBucket",
        "s3:GetBucketLocation",
        "s3:ListBucket",
        "s3:ListBucketVersions",
        "s3:PutBucketPublicAccessBlock",
        "s3:PutBucketVersioning",
        "s3:GetBucketTagging",
        "s3:PutBucketTagging",
        "s3:PutLifecycleConfiguration",
        "s3:PutObject",
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:DeleteObject",
        "s3:DeleteObjectVersion"
      ],
      "Resource": [
        "arn:aws:s3:::bike-demand-mlops-*",
        "arn:aws:s3:::bike-demand-mlops-*/*"
      ]
    },
    {
      "Sid": "CreateOrChangeRoleOnlyWithBoundary",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:PutRolePolicy"
      ],
      "Resource": "arn:aws:iam::*:role/bike-demand-predict-role",
      "Condition": {
        "StringLike": {
          "iam:PermissionsBoundary": "arn:aws:iam::*:policy/bike-demand-predict-boundary"
        }
      }
    },
    {
      "Sid": "LambdaExecutionRole",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:TagRole",
        "iam:ListRolePolicies",
        "iam:DeleteRolePolicy",
        "iam:DeleteRole",
        "iam:ListRoleTags"
      ],
      "Resource": "arn:aws:iam::*:role/bike-demand-predict-role"
    },
    {
      "Sid": "ReadBoundaryPolicy",
      "Effect": "Allow",
      "Action": [
        "iam:GetPolicy",
        "iam:ListPolicyTags"
      ],
      "Resource": "arn:aws:iam::*:policy/bike-demand-predict-boundary"
    },
    {
      "Sid": "PassRoleToLambdaOnly",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::*:role/bike-demand-predict-role",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "lambda.amazonaws.com"
        }
      }
    },
    {
      "Sid": "Function",
      "Effect": "Allow",
      "Action": [
        "lambda:CreateFunction",
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration",
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration",
        "lambda:PublishVersion",
        "lambda:ListVersionsByFunction",
        "lambda:PutFunctionConcurrency",
        "lambda:DeleteFunctionConcurrency",
        "lambda:CreateAlias",
        "lambda:UpdateAlias",
        "lambda:GetAlias",
        "lambda:InvokeFunction",
        "lambda:TagResource",
        "lambda:DeleteFunction",
        "lambda:ListTags"
      ],
      "Resource": [
        "arn:aws:lambda:*:*:function:bike-demand-predict",
        "arn:aws:lambda:*:*:function:bike-demand-predict:*"
      ]
    },
    {
      "Sid": "FunctionLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:PutRetentionPolicy",
        "logs:TagResource",
        "logs:TagLogGroup",
        "logs:DescribeLogStreams",
        "logs:FilterLogEvents",
        "logs:GetLogEvents",
        "logs:DeleteLogGroup",
        "logs:ListTagsLogGroup",
        "logs:ListTagsForResource"
      ],
      "Resource": "arn:aws:logs:*:*:log-group:/aws/lambda/bike-demand-predict*"
    },
    {
      "Sid": "ListLogGroups",
      "Effect": "Allow",
      "Action": "logs:DescribeLogGroups",
      "Resource": "*"
    }
  ]
}
