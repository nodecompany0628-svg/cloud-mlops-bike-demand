{
  "description": "서비스 정상 동작 검사. 같은 사례를 로컬 핸들러(check-local)와 클라우드 Lambda(smoke)에 똑같이 보낸다.",
  "cases": [
    {
      "name": "normal_one_hour",
      "about": "정상 입력 1건 (2012-10-01 월요일 출근 시간)",
      "payload": {
        "instances": [
          {
            "datetime": "2012-10-01T08:00",
            "holiday": false,
            "weather": 1,
            "temp_c": 17.5,
            "feels_like_c": 21.0,
            "humidity": 72,
            "windspeed_kmh": 9.0
          }
        ]
      },
      "expect": {
        "status": 200,
        "n": 1
      }
    },
    {
      "name": "normal_day_24h",
      "about": "정상 입력 24건 (평가 기간 하루 전체), 두 번 보내 결과가 같은지 확인",
      "payload_file": "samples/generated/request_{sample_day}.json",
      "repeat": 2,
      "expect": {
        "status": 200,
        "n": 24
      }
    },
    {
      "name": "target_field_ignored",
      "about": "정답(cnt)을 입력에 넣어도 예측에 쓰이지 않음",
      "payload": {
        "instances": [
          {
            "datetime": "2012-10-01T08:00",
            "holiday": false,
            "weather": 1,
            "temp_c": 17.5,
            "feels_like_c": 21.0,
            "humidity": 72,
            "windspeed_kmh": 9.0,
            "cnt": 999
          }
        ]
      },
      "expect": {
        "status": 200,
        "n": 1,
        "same_prediction_as": "normal_one_hour",
        "warning_contains": "알 수 없는 필드"
      }
    },
    {
      "name": "year_outside_training",
      "about": "학습 기간 밖 연도는 경고와 함께 2012년 수준으로 계산",
      "payload": {
        "instances": [
          {
            "datetime": "2026-05-05T18:00",
            "holiday": true,
            "weather": 2,
            "temp_c": 21.0,
            "feels_like_c": 21.0,
            "humidity": 55,
            "windspeed_kmh": 12.0
          }
        ]
      },
      "expect": {
        "status": 200,
        "n": 1,
        "warning_contains": "학습 기간"
      }
    },
    {
      "name": "missing_humidity",
      "about": "필수 입력 누락",
      "payload": {
        "instances": [
          {
            "datetime": "2012-10-01T08:00",
            "holiday": false,
            "weather": 1,
            "temp_c": 17.5,
            "feels_like_c": 21.0,
            "windspeed_kmh": 9.0
          }
        ]
      },
      "expect": {
        "status": 400,
        "error_code": "INVALID_INPUT",
        "error_field": "humidity"
      }
    },
    {
      "name": "hour_out_of_range",
      "about": "없는 시각(25시)",
      "payload": {
        "instances": [
          {
            "datetime": "2012-10-01T25:00",
            "holiday": false,
            "weather": 1,
            "temp_c": 17.5,
            "feels_like_c": 21.0,
            "humidity": 72,
            "windspeed_kmh": 9.0
          }
        ]
      },
      "expect": {
        "status": 400,
        "error_code": "INVALID_INPUT",
        "error_field": "datetime"
      }
    },
    {
      "name": "weather_out_of_range",
      "about": "날씨 코드 5 (허용 1~4)",
      "payload": {
        "instances": [
          {
            "datetime": "2012-10-01T08:00",
            "holiday": false,
            "weather": 5,
            "temp_c": 17.5,
            "feels_like_c": 21.0,
            "humidity": 72,
            "windspeed_kmh": 9.0
          }
        ]
      },
      "expect": {
        "status": 400,
        "error_code": "INVALID_INPUT",
        "error_field": "weather"
      }
    },
    {
      "name": "temp_as_string",
      "about": "숫자 자리에 문자열",
      "payload": {
        "instances": [
          {
            "datetime": "2012-10-01T08:00",
            "holiday": false,
            "weather": 1,
            "temp_c": "17.5",
            "feels_like_c": 21.0,
            "humidity": 72,
            "windspeed_kmh": 9.0
          }
        ]
      },
      "expect": {
        "status": 400,
        "error_code": "INVALID_INPUT",
        "error_field": "temp_c"
      }
    },
    {
      "name": "humidity_out_of_range",
      "about": "습도 130%",
      "payload": {
        "instances": [
          {
            "datetime": "2012-10-01T08:00",
            "holiday": false,
            "weather": 1,
            "temp_c": 17.5,
            "feels_like_c": 21.0,
            "humidity": 130,
            "windspeed_kmh": 9.0
          }
        ]
      },
      "expect": {
        "status": 400,
        "error_code": "INVALID_INPUT",
        "error_field": "humidity"
      }
    },
    {
      "name": "empty_instances",
      "about": "빈 목록",
      "payload": {
        "instances": []
      },
      "expect": {
        "status": 400,
        "error_code": "INVALID_INPUT"
      }
    },
    {
      "name": "no_instances_key",
      "about": "instances 키 없음",
      "payload": {
        "rows": []
      },
      "expect": {
        "status": 400,
        "error_code": "INVALID_INPUT"
      }
    },
    {
      "name": "too_many_instances",
      "about": "한도(1000건) 초과",
      "generate": {
        "repeat_instance_of": "normal_one_hour",
        "count": 1001
      },
      "expect": {
        "status": 400,
        "error_code": "TOO_MANY_INSTANCES"
      }
    }
  ]
}
