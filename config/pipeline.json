{
  "project": "bike-demand-mlops",
  "data": {
    "url": "https://archive.ics.uci.edu/static/public/275/bike+sharing+dataset.zip",
    "zip_sha256": "b70182d0d0508e9abbb79306ce5c0cec34869000f8220175ac83d11dbe845401",
    "files": {
      "hour.csv": "e03de4ee4ef4dc376ac6e04bf829673c6269e8eba5c60fa121640fa2f829504f",
      "Readme.txt": "b92c8628622948bf0828c43a1b315d1517c3d7fd63654730d0dea379b8e88175"
    },
    "raw_dir": "data/raw",
    "processed_dir": "data/processed"
  },
  "split": {
    "train_start": "2011-01-01",
    "train_end": "2012-08-31",
    "test_start": "2012-09-01",
    "test_end": "2012-12-31"
  },
  "model": {
    "name": "bike-hgb",
    "version": "hgb-v1",
    "params": {
      "loss": "poisson",
      "learning_rate": 0.05,
      "max_iter": 500,
      "max_leaf_nodes": 31,
      "min_samples_leaf": 20,
      "early_stopping": false,
      "random_state": 42
    }
  },
  "evaluation": {
    "criteria": {
      "must_beat_all_baselines": true,
      "min_mae_reduction_vs_hour_baseline": 0.30
    },
    "sample_day": "2012-12-03",
    "cloud_batch_size": 500
  },
  "cloud": {
    "region": "ap-northeast-2",
    "profile": null,
    "function_name": "bike-demand-predict",
    "role_name": "bike-demand-predict-role",
    "bucket_prefix": "bike-demand-mlops",
    "lambda_config": "config/lambda.json",
    "tags": {
      "project": "cloud-mlops-assignment",
      "owner": "student"
    }
  }
}
